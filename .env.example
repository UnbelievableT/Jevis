# These are shell environment variable examples; the daemon does not auto-load .env.
# Never commit credentials.
JEVIS_HOST=127.0.0.1
JEVIS_PORT=4317
# Generated automatically under .jevis/token when omitted.
# JEVIS_TOKEN=
# JEVIS_DATA_DIR=
# TYPESAFE_API_KEY=
# JEVIS_JEV_MODEL=  # Explicit vendor model ID; no silent latest-model drift.
