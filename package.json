{
  "name": "jevis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm assets:sync && node scripts/dev.mjs",
    "build": "pnpm assets:sync && pnpm --filter @jevis/desktop build && pnpm --filter @jevis/web build && pnpm --filter @jevis/mobile build && tsup apps/daemon/src/main.ts apps/cli/src/main.ts apps/mcp/src/main.ts --format esm --platform node --target node24 --out-dir dist --external node:sqlite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "assets:sync": "node scripts/sync-assets.mjs",
    "deps:fetch": "node scripts/deps.mjs fetch",
    "deps:verify": "node scripts/deps.mjs verify",
    "daemon": "tsx apps/daemon/src/main.ts",
    "cli": "tsx apps/cli/src/main.ts",
    "mcp": "tsx apps/mcp/src/main.ts",
    "desktop:dev": "pnpm assets:sync && pnpm icons:generate && pnpm --filter @jevis/desktop tauri dev",
    "desktop:build": "pnpm assets:sync && pnpm icons:generate && pnpm --filter @jevis/desktop tauri build",
    "icons:generate": "pnpm --filter @jevis/desktop exec tauri icon ../../assets/brand/logo.png --output src-tauri/icons",
    "smoke:ui": "node scripts/smoke-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "~5.8.3",
    "tsx": "^4.19.4",
    "tsup": "^8.5.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.52.0",
    "prettier": "^3.5.0"
  },
  "dependencies": {
    "zod": "^3.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "xstate": "^5.19.0",
    "@xyflow/react": "^12.6.0"
  }
}
